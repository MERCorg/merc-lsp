{
	"name": "merc-lsp-client",
	"displayName": "Merc Language Support",
	"description": "Language support for merc specifications, backed by the merc-lsp language server",
	"author": "Maurice Laveauxn",
	"license": "BSL-1.0",
	"version": "1.0.0",
	"publisher": "MERCorg",
	"repository": {
		"type": "git",
		"url": "https://github.com/MERCorg/merc-lsp"
	},
	"categories": [
		"Programming Languages",
		"Linters"
	],
	"engines": {
		"vscode": "^1.134.0"
	},
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "merc-lsp.restartServer",
				"title": "merc: Restart Language Server"
			}
		],
		"languages": [
			{
				"id": "merc",
				"aliases": [
					"MERC",
					"merc"
				],
				"extensions": [
					".mcrl2"
				],
				"configuration": "./language-configuration.json"
			},
			{
				"id": "merc-pbes",
				"aliases": [
					"PBES",
					"pbes"
				],
				"extensions": [
					".pbes"
				],
				"configuration": "./language-configuration.json"
			},
			{
				"id": "merc-pres",
				"aliases": [
					"PRES",
					"pres"
				],
				"extensions": [
					".pres"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "merc",
				"scopeName": "source.merc",
				"path": "./syntaxes/merc.tmLanguage.json"
			},
			{
				"language": "merc-pbes",
				"scopeName": "source.merc",
				"path": "./syntaxes/merc.tmLanguage.json"
			},
			{
				"language": "merc-pres",
				"scopeName": "source.merc",
				"path": "./syntaxes/merc.tmLanguage.json"
			}
		],
		"semanticTokenScopes": [
			{
				"language": "merc",
				"scopes": {
					"type": ["entity.name.type"],
					"type.defaultLibrary": ["support.type"],
					"variable": ["variable.other"],
					"method": ["entity.name.function"],
					"event": ["entity.name.tag"],
					"enumMember": ["variable.other.enummember"],
					"parameter": ["variable.parameter"],
					"keyword": ["keyword.control"]
				}
			},
			{
				"language": "merc-pbes",
				"scopes": {
					"type": ["entity.name.type"],
					"type.defaultLibrary": ["support.type"],
					"variable": ["variable.other"],
					"method": ["entity.name.function"],
					"event": ["entity.name.tag"],
					"enumMember": ["variable.other.enummember"],
					"parameter": ["variable.parameter"],
					"keyword": ["keyword.control"]
				}
			},
			{
				"language": "merc-pres",
				"scopes": {
					"type": ["entity.name.type"],
					"type.defaultLibrary": ["support.type"],
					"variable": ["variable.other"],
					"method": ["entity.name.function"],
					"event": ["entity.name.tag"],
					"enumMember": ["variable.other.enummember"],
					"parameter": ["variable.parameter"],
					"keyword": ["keyword.control"]
				}
			}
		],
		"configuration": {
			"type": "object",
			"title": "MERC",
			"properties": {
				"merc-lsp.serverPath": {
					"type": "string",
					"default": "",
					"description": "Path to the merc-lsp executable. Leave empty to use the binary bundled with this extension, falling back to a `merc-lsp` found on your PATH."
				},
				"merc-lsp.trace.server": {
					"type": "string",
					"enum": [
						"off",
						"messages",
						"verbose"
					],
					"default": "off",
					"description": "Traces the communication between VS Code and the merc-lsp language server."
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -w -p ./",
		"package": "vsce package"
	},
	"dependencies": {
		"vscode-languageclient": "^10.0"
	},
	"devDependencies": {
		"@types/node": "^26.3",
		"@types/vscode": "^1.134.0",
		"@vscode/test-electron": "^3.1",
		"@vscode/vsce": "^3.2",
		"typescript": "^5.7"
	}
}
